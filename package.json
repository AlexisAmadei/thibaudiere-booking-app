{
  "name": "thibaudiere",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --parallel dev:client dev:server",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "test": "node --test \"server/**/*.test.ts\"",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.39.4",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router": "^7.18.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  }
}
