{
  "name": "thibaudiere",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --parallel dev:client dev:server",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "test": "node --test \"server/**/*.test.ts\" \"src/**/*.test.ts\"",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:auth-schema": "auth generate --config server/auth.cli.ts --output server/db/auth-schema.ts --yes",
    "db:seed": "node server/db/seed.ts",
    "db:backup": "node server/db/backup.ts",
    "db:pull": "node --env-file-if-exists=.env server/db/pull.ts",
    "invite": "node server/invite.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.13",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "auth": "1.7.13",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router": "^7.18.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "source-map-js": "^1.2.2"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
