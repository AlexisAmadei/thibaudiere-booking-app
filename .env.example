# Copy to .env for local development. In production these are set in Dokploy.

# Public URL of the app. Required (the server refuses to start without it).
APP_URL=http://localhost:5173
# Signs session cookies. Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Email via Resend. ADMIN_EMAIL receives the new-booking notification.
RESEND_API_KEY=
ADMIN_EMAIL=

# Sender, required when RESEND_API_KEY is set. On a domain verified in Resend:
# `name@domain` or `Name <name@domain>`.
RESEND_FROM=

# Optional. PORT is 3000 by default; DATABASE_PATH defaults to ./data/dev.sqlite.
# PORT=3000
# DATABASE_PATH=data/dev.sqlite

# Nightly backup (`bun run db:backup`) and `bun run db:pull`, to an S3-compatible bucket (R2).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# One-off import from Supabase (`bun run db:import`).
# SUPABASE_DB_URL=
