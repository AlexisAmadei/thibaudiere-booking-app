{
  // The server runs as `.ts` directly on Node 24 (native type stripping), so only
  // erasable syntax is allowed and relative imports keep their `.ts` extension.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  // Also the SPA's tests (`src/**/*.test.ts`), which run its `src/api` client against this server.
  "include": [".", "../src/**/*.test.ts"]
}
